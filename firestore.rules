rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function emailGate() {
      return signedIn() && (
        request.auth.token.firebase.sign_in_provider in ['google.com', 'phone'] ||
        request.auth.token.email_verified == true
      );
    }

    function notRestricted() {
      let modPath = /databases/$(database)/documents/users/$(request.auth.uid)/private/moderation;
      return !exists(modPath) || get(modPath).data.restricted != true;
    }

    function validString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isPrivacyAudience(val) {
      return val in ['everyone', 'contacts', 'nobody'];
    }

    function canViewRestrictedField(ownerUid, fieldKey) {
      let settingsPath = /databases/$(database)/documents/users/$(ownerUid)/private/settings;
      let setting = exists(settingsPath) ? get(settingsPath).data.privacy[fieldKey] : 'everyone';
      let isContact = exists(/databases/$(database)/documents/users/$(ownerUid)/contacts/$(request.auth.uid));
      return isOwner(ownerUid) ||
        setting == 'everyone' ||
        (setting == 'contacts' && isContact);
    }

    function isParticipant(cid) {
      return signedIn() &&
        exists(/databases/$(database)/documents/conversations/$(cid)/members/$(request.auth.uid));
    }

    function memberRole(cid, uid) {
      return get(/databases/$(database)/documents/conversations/$(cid)/members/$(uid)).data.role;
    }

    // Connectivity probe document (read-only ping)
    match /test/connection {
      allow get: if signedIn();
      allow list, write: if false;
    }

    // User public profile (get only, no list scraping)
    match /users/{uid} {
      allow get: if signedIn() && isValidId(uid);
      allow list: if false;
      allow create: if isOwner(uid) && isValidId(uid) &&
        request.resource.data.keys().hasAll(['schemaVersion', 'displayName', 'displayNameLower', 'username', 'createdAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['schemaVersion', 'displayName', 'displayNameLower', 'username', 'createdAt', 'updatedAt']) &&
        request.resource.data.schemaVersion is number &&
        validString(request.resource.data.displayName, 1, 60) &&
        validString(request.resource.data.displayNameLower, 1, 60) &&
        request.resource.data.username == null &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isOwner(uid) && isValidId(uid) &&
        changedOnly(['displayName', 'displayNameLower', 'updatedAt']) &&
        validString(request.resource.data.displayName, 1, 60) &&
        validString(request.resource.data.displayNameLower, 1, 60) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.username == resource.data.username &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /restricted/photo {
        allow get: if signedIn() && isValidId(uid) && canViewRestrictedField(uid, 'profilePhoto');
        allow list: if false;
        allow create, update: if isOwner(uid) && isValidId(uid) &&
          request.resource.data.keys().hasAll(['schemaVersion', 'photoPath', 'photoURL', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'photoPath', 'photoURL', 'updatedAt']) &&
          request.resource.data.schemaVersion is number &&
          (request.resource.data.photoPath == null || validString(request.resource.data.photoPath, 1, 300)) &&
          (request.resource.data.photoURL == null || validString(request.resource.data.photoURL, 1, 2048)) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /restricted/about {
        allow get: if signedIn() && isValidId(uid) && canViewRestrictedField(uid, 'about');
        allow list: if false;
        allow create, update: if isOwner(uid) && isValidId(uid) &&
          request.resource.data.keys().hasAll(['schemaVersion', 'text', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'text', 'updatedAt']) &&
          request.resource.data.schemaVersion is number &&
          validString(request.resource.data.text, 0, 139) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      match /private/account {
        allow get: if isOwner(uid);
        allow list, write: if false;
      }

      match /private/moderation {
        allow read, write: if false;
      }

      match /private/settings {
        allow get: if isOwner(uid);
        allow list: if false;
        allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasAll(['schemaVersion', 'privacy', 'notifications', 'mutedStatusAuthors', 'theme', 'locale']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'privacy', 'notifications', 'mutedStatusAuthors', 'theme', 'locale']) &&
          request.resource.data.schemaVersion is number &&
          isPrivacyAudience(request.resource.data.privacy.lastSeen) &&
          isPrivacyAudience(request.resource.data.privacy.onlineStatus) &&
          isPrivacyAudience(request.resource.data.privacy.profilePhoto) &&
          isPrivacyAudience(request.resource.data.privacy.about) &&
          request.resource.data.privacy.readReceipts is bool &&
          request.resource.data.privacy.typingIndicators is bool &&
          request.resource.data.privacy.groupAdd in ['everyone', 'contacts'] &&
          request.resource.data.privacy.statusAudience.mode in ['contacts', 'excludeList', 'onlyList'] &&
          request.resource.data.privacy.statusAudience.uids is list &&
          request.resource.data.privacy.statusAudience.uids.size() <= 1000 &&
          request.resource.data.privacy.findableByUsername is bool &&
          request.resource.data.privacy.findableByPhone is bool &&
          request.resource.data.privacy.findableByEmail is bool &&
          request.resource.data.notifications.messages is bool &&
          request.resource.data.notifications.groups is bool &&
          request.resource.data.notifications.calls is bool &&
          request.resource.data.notifications.statusUpdates is bool &&
          request.resource.data.notifications.showPreviews is bool &&
          request.resource.data.mutedStatusAuthors is list &&
          request.resource.data.mutedStatusAuthors.size() <= 500 &&
          request.resource.data.theme in ['light', 'dark', 'system'] &&
          validString(request.resource.data.locale, 2, 16);
        allow delete: if false;
      }

      match /contacts/{contactUid} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(contactUid) && contactUid != uid &&
          request.resource.data.keys().hasAll(['schemaVersion', 'addedAt', 'source', 'nickname']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'addedAt', 'source', 'nickname']) &&
          request.resource.data.schemaVersion is number &&
          request.resource.data.source in ['manual', 'discovery', 'invite', 'contactPicker'] &&
          (request.resource.data.nickname == null || validString(request.resource.data.nickname, 1, 64)) &&
          request.resource.data.addedAt is timestamp;
        allow delete: if isOwner(uid);
      }

      match /blocks/{blockedUid} {
        allow get, list: if isOwner(uid);
        allow create: if isOwner(uid) && isValidId(blockedUid) && blockedUid != uid &&
          request.resource.data.keys().hasAll(['schemaVersion', 'blockedAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'blockedAt']) &&
          request.resource.data.blockedAt == request.time;
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      match /devices/{deviceId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(deviceId) &&
          request.resource.data.keys().hasAll(['schemaVersion', 'fcmToken', 'platform', 'appVersion', 'userAgentSummary', 'notificationsEnabled', 'createdAt', 'lastSeenAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'fcmToken', 'platform', 'appVersion', 'userAgentSummary', 'notificationsEnabled', 'createdAt', 'lastSeenAt']) &&
          (request.resource.data.fcmToken == null || validString(request.resource.data.fcmToken, 1, 512)) &&
          validString(request.resource.data.platform, 1, 64) &&
          validString(request.resource.data.appVersion, 1, 32) &&
          validString(request.resource.data.userAgentSummary, 1, 160) &&
          request.resource.data.notificationsEnabled is bool &&
          request.resource.data.lastSeenAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /notifications/{nid} {
        allow get, list: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid) &&
          changedOnly(['read']) &&
          request.resource.data.read is bool;
        allow delete: if isOwner(uid);
      }

      match /chatStates/{cid} {
        allow get, list: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid) &&
          changedOnly(['pinned', 'pinnedAt', 'archived', 'mutedUntil', 'unreadCount', 'markedUnread', 'clearedAt', 'lastOpenedAt']) &&
          request.resource.data.pinned is bool &&
          request.resource.data.archived is bool &&
          request.resource.data.markedUnread is bool &&
          request.resource.data.unreadCount is int &&
          (request.resource.data.unreadCount == 0 || request.resource.data.unreadCount == resource.data.unreadCount);
        allow delete: if false;

        match /hiddenMessages/{mid} {
          allow get, list: if isOwner(uid);
          allow create: if isOwner(uid) && isValidId(mid) &&
            request.resource.data.keys().hasAll(['schemaVersion', 'hiddenAt']) &&
            request.resource.data.keys().hasOnly(['schemaVersion', 'hiddenAt']) &&
            request.resource.data.hiddenAt == request.time;
          allow update: if false;
          allow delete: if isOwner(uid);
        }
      }
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /phoneIndex/{hmac} {
      allow read, write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /groupInvites/{code} {
      allow read, write: if false;
    }

    // Presence
    match /presence/{uid} {
      allow get: if signedIn() && isValidId(uid) && (
        isOwner(uid) ||
        (
          canViewRestrictedField(uid, 'lastSeen') &&
          canViewRestrictedField(request.auth.uid, 'lastSeen')
        )
      );
      allow list: if false;
      allow create, update: if isOwner(uid) && isValidId(uid) &&
        request.resource.data.keys().hasAll(['schemaVersion', 'state', 'lastActiveAt', 'updatedAt']) &&
        request.resource.data.keys().hasOnly(['schemaVersion', 'state', 'lastActiveAt', 'updatedAt']) &&
        request.resource.data.schemaVersion is number &&
        request.resource.data.state in ['online', 'offline'] &&
        request.resource.data.lastActiveAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Conversations and Messages
    match /conversations/{cid} {
      allow get: if signedIn() && isValidId(cid) && request.auth.uid in resource.data.participantIds;
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, delete: if false;
      allow update: if signedIn() && isValidId(cid) &&
        request.auth.uid in resource.data.participantIds &&
        changedOnly(['lastMessage', 'lastMessageAt', 'updatedAt']) &&
        request.resource.data.lastMessageAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.lastMessage is map &&
        request.resource.data.lastMessage.keys().hasAll(['id', 'senderId', 'type', 'textPreview', 'createdAt']) &&
        request.resource.data.lastMessage.keys().hasOnly(['id', 'senderId', 'type', 'textPreview', 'createdAt']) &&
        request.resource.data.lastMessage.senderId == request.auth.uid &&
        validString(request.resource.data.lastMessage.textPreview, 0, 100) &&
        request.resource.data.lastMessage.createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/conversations/$(cid)/messages/$(request.resource.data.lastMessage.id));

      match /members/{uid} {
        allow get, list: if isParticipant(cid);
        allow create, delete: if false;
        allow update: if isOwner(uid) && isParticipant(cid) &&
          changedOnly(['lastDeliveredAt', 'lastReadAt', 'lastReadMessageId']) &&
          (
            request.resource.data.lastDeliveredAt == resource.data.lastDeliveredAt ||
            (
              request.resource.data.lastDeliveredAt is timestamp &&
              request.resource.data.lastDeliveredAt <= request.time &&
              (resource.data.lastDeliveredAt == null || request.resource.data.lastDeliveredAt >= resource.data.lastDeliveredAt)
            )
          ) &&
          (
            request.resource.data.lastReadAt == resource.data.lastReadAt ||
            (
              request.resource.data.lastReadAt is timestamp &&
              request.resource.data.lastReadAt <= request.time &&
              (resource.data.lastReadAt == null || request.resource.data.lastReadAt >= resource.data.lastReadAt)
            )
          );
      }

      match /typing/{uid} {
        allow get, list: if isParticipant(cid);
        allow create, update: if isOwner(uid) && isParticipant(cid) &&
          request.resource.data.keys().hasAll(['schemaVersion', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid) && isParticipant(cid);
      }

      match /joinRequests/{uid} {
        allow get, list: if isParticipant(cid) && memberRole(cid, request.auth.uid) in ['owner', 'admin'];
        allow write: if false;
      }

      match /messages/{mid} {
        allow get, list: if isParticipant(cid);
        allow create: if emailGate() && notRestricted() && isParticipant(cid) && isValidId(mid) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['text', 'image', 'video', 'audio', 'voice', 'document'] &&
          request.resource.data.forwarded == false &&
          request.resource.data.deletedForEveryone == false &&
          request.resource.data.editedAt == null &&
          request.resource.data.deletedAt == null &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.mentions is list &&
          request.resource.data.mentions.size() <= 50 &&
          request.resource.data.reactions is map &&
          request.resource.data.reactions.size() == 0 &&
          (request.resource.data.text == null || (
            request.resource.data.type == 'text'
              ? validString(request.resource.data.text, 1, 4096)
              : validString(request.resource.data.text, 0, 1024)
          )) &&
          (
            get(/databases/$(database)/documents/conversations/$(cid)).data.type == 'direct' ||
            get(/databases/$(database)/documents/conversations/$(cid)).data.group.settings.sendMessages == 'all' ||
            memberRole(cid, request.auth.uid) in ['owner', 'admin']
          ) &&
          getAfter(/databases/$(database)/documents/conversations/$(cid)).data.lastMessage.id == mid;

        allow update: if isParticipant(cid) && (
          // Edit text or caption within 15 minutes
          (
            resource.data.senderId == request.auth.uid &&
            resource.data.deletedForEveryone == false &&
            resource.data.type in ['text', 'image', 'video', 'audio', 'document'] &&
            changedOnly(['text', 'editedAt']) &&
            request.resource.data.editedAt == request.time &&
            request.time <= resource.data.createdAt + duration.value(15, 'm') &&
            (
              resource.data.type == 'text'
                ? validString(request.resource.data.text, 1, 4096)
                : (request.resource.data.text == null || validString(request.resource.data.text, 0, 1024))
            )
          ) ||
          // Delete for everyone within 48 hours
          (
            resource.data.senderId == request.auth.uid &&
            resource.data.deletedForEveryone == false &&
            changedOnly(['deletedForEveryone', 'deletedAt', 'text', 'media', 'replyTo']) &&
            request.resource.data.deletedForEveryone == true &&
            request.resource.data.deletedAt == request.time &&
            request.resource.data.text == null &&
            request.resource.data.media == null &&
            request.resource.data.replyTo == null &&
            request.time <= resource.data.createdAt + duration.value(48, 'h')
          ) ||
          // Reaction for caller's own UID only
          (
            resource.data.deletedForEveryone == false &&
            changedOnly(['reactions']) &&
            request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]) &&
            (
              !(request.auth.uid in request.resource.data.reactions) ||
              validString(request.resource.data.reactions[request.auth.uid], 1, 8)
            )
          )
        );
        allow delete: if false;
      }
    }

    // Statuses
    match /statuses/{sid} {
      allow get: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        (request.auth.uid in resource.data.viewerIds && resource.data.expiresAt > request.time)
      );
      allow list: if signedIn() && (
        resource.data.authorId == request.auth.uid ||
        request.auth.uid in resource.data.viewerIds
      );
      allow create, update: if false;
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /views/{viewerUid} {
        allow get, list: if signedIn() && (
          isOwner(viewerUid) ||
          get(/databases/$(database)/documents/statuses/$(sid)).data.authorId == request.auth.uid
        );
        allow create: if isOwner(viewerUid) &&
          get(/databases/$(database)/documents/statuses/$(sid)).data.authorId != viewerUid &&
          request.auth.uid in get(/databases/$(database)/documents/statuses/$(sid)).data.viewerIds &&
          get(/databases/$(database)/documents/statuses/$(sid)).data.expiresAt > request.time &&
          request.resource.data.keys().hasAll(['schemaVersion', 'viewedAt']) &&
          request.resource.data.keys().hasOnly(['schemaVersion', 'viewedAt']) &&
          request.resource.data.viewedAt == request.time;
        allow update, delete: if false;
      }
    }

    // One-to-one Calls
    match /calls/{callId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds && (
        // Callee accepts, declines, or signals busy from ringing
        (
          request.auth.uid == resource.data.calleeId &&
          resource.data.state == 'ringing' &&
          (
            (
              request.resource.data.state == 'accepted' &&
              changedOnly(['state', 'answeredAt']) &&
              request.resource.data.answeredAt == request.time
            ) ||
            (
              request.resource.data.state in ['declined', 'busy'] &&
              changedOnly(['state', 'endedAt', 'endedBy', 'endReason']) &&
              request.resource.data.endedAt == request.time &&
              request.resource.data.endedBy == request.auth.uid
            )
          )
        ) ||
        // Caller cancels or marks missed from ringing
        (
          request.auth.uid == resource.data.callerId &&
          resource.data.state == 'ringing' &&
          request.resource.data.state in ['cancelled', 'missed'] &&
          changedOnly(['state', 'endedAt', 'endedBy', 'endReason']) &&
          request.resource.data.endedAt == request.time &&
          request.resource.data.endedBy == request.auth.uid
        ) ||
        // Either participant ends an accepted call
        (
          resource.data.state == 'accepted' &&
          request.resource.data.state in ['ended', 'failed'] &&
          changedOnly(['state', 'endedAt', 'endedBy', 'endReason']) &&
          request.resource.data.endedAt == request.time &&
          request.resource.data.endedBy == request.auth.uid
        )
      );

      match /signals/{sigId} {
        allow get, list: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds;
        allow create: if signedIn() && isValidId(sigId) &&
          request.auth.uid in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds &&
          request.resource.data.from == request.auth.uid &&
          request.resource.data.to in get(/databases/$(database)/documents/calls/$(callId)).data.participantIds &&
          request.resource.data.to != request.auth.uid &&
          request.resource.data.kind in ['offer', 'answer', 'candidate'] &&
          request.resource.data.createdAt == request.time &&
          (request.resource.data.sdp == null || validString(request.resource.data.sdp, 1, 8192)) &&
          (request.resource.data.candidate == null || validString(request.resource.data.candidate, 1, 8192));
        allow update, delete: if false;
      }
    }

    // Moderation Reports (create-only for signed-in users, no client reads)
    match /reports/{rid} {
      allow read, update, delete: if false;
      allow create: if signedIn() && isValidId(rid) &&
        request.resource.data.reporterId == request.auth.uid &&
        request.resource.data.targetType in ['user', 'message', 'group', 'status'] &&
        validString(request.resource.data.targetId, 1, 128) &&
        request.resource.data.reason in ['spam', 'harassment', 'hate', 'violence', 'sexual', 'scam', 'other'] &&
        validString(request.resource.data.details, 0, 1000) &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
    }
  }
}
