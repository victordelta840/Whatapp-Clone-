# Converse — Client Firebase Web Config (public identifiers only; never place secrets here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# FCM Web Push VAPID public key (from Firebase Console -> Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=

# Firebase App Check reCAPTCHA Enterprise (or v3 fallback) public site key
VITE_APPCHECK_SITE_KEY=

# Cloud Functions region (must match deployed 2nd-gen functions region)
VITE_FUNCTIONS_REGION=us-central1

# Optional flags
VITE_USE_EMULATORS=false
VITE_APP_NAME=Converse

# Development-only App Check debug token (never set in production)
VITE_APPCHECK_DEBUG_TOKEN=
